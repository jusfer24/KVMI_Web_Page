---
import { Image } from "astro:assets";
import logo from "../assets/images/Logos/Logo_KVMI.png";
import QuickCart from "./react/QuickCart.tsx";
import { getLangFromUrl, localizePath, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/* Site Map Visual: sin item "Home"; el logotipo enlaza al inicio.
   Todos los accesos a los demas sitios viven comprimidos en el menu
   lateral izquierdo (ver #kvmi-side-menu), en cualquier ancho de pantalla. */
const links = [
  { href: "/the-origin", key: "nav.origin" },
  { href: "/collections", key: "nav.collections" },
  { href: "/el-ritual", key: "nav.ritual" },
  { href: "/exclusive-handicrafts", key: "nav.handicrafts" },
  { href: "/contact", key: "nav.contact" },
] as const;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-night/80 backdrop-blur-md">
  <nav class="mx-auto grid max-w-7xl grid-cols-[1fr_auto_1fr] items-center gap-10 px-6 py-3 lg:px-10">
    <div class="flex items-center justify-start">
      <button
        id="kvmi-side-menu-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="kvmi-side-menu"
        class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 rounded-full border border-stone/40 transition-colors duration-300 hover:border-gold-deep"
      >
        <span class="block h-px w-5 bg-mist"></span>
        <span class="block h-px w-5 bg-mist"></span>
      </button>
    </div>

    <a
      href={localizePath(lang, "/")}
      aria-label="KVMI"
      class="group flex items-center justify-self-center"
    >
      {/* Presencia maxima de marca; reduccion minima respetada; resaltado sutil en hover */}
      <Image
        src={logo}
        alt="KVMI"
        class="h-16 w-auto min-h-16 object-contain transition-all duration-300 ease-out group-hover:scale-105 group-hover:drop-shadow-[0_0_16px_rgba(246,211,0,0.45)]"
        loading="eager"
      />
    </a>

    <div class="flex items-center justify-end gap-3">
      {/* Carrito: vista rapida de la seleccion */}
      <QuickCart client:load lang={lang} />

      {/* Acceso a cuenta */}
      <a
        href={localizePath(lang, "/login")}
        aria-label={t("nav.account")}
        class="group flex h-11 w-11 items-center justify-center rounded-full border border-stone/40 transition-colors duration-300 hover:border-gold-deep"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          class="h-4 w-4 text-mist group-hover:text-gold"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="3.5"></circle>
          <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
        </svg>
      </a>
    </div>
  </nav>
</header>

{/* Menu lateral: comprime el acceso a todos los demas sitios */}
<div
  id="kvmi-side-menu"
  class="fixed inset-0 z-60 pointer-events-none opacity-0 transition-opacity duration-300"
  aria-hidden="true"
>
  <div
    id="kvmi-side-menu-backdrop"
    class="absolute inset-0 bg-night/80 backdrop-blur-sm"
  >
  </div>

  <div
    id="kvmi-side-menu-panel"
    class="absolute inset-y-0 left-0 flex w-[85vw] max-w-xs -translate-x-full flex-col border-r border-white/10 bg-night transition-transform duration-300 ease-out"
  >
    <div class="flex items-center justify-between border-b border-white/5 px-6 py-4">
      <Image src={logo} alt="KVMI" class="h-10 w-auto object-contain" />
      <button
        id="kvmi-side-menu-close"
        type="button"
        aria-label="Close menu"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-stone/40 text-mist transition-colors duration-300 hover:border-gold-deep hover:text-gold"
      >
        <span class="text-lg leading-none">&times;</span>
      </button>
    </div>

    <ul class="flex flex-1 flex-col gap-1 overflow-y-auto px-6 py-6">
      {
        links.map((link) => {
          const href = localizePath(lang, link.href);
          return (
            <li>
              <a
                href={href}
                class:list={[
                  "block py-3 text-xs uppercase tracking-luxe transition-colors duration-300 hover:text-gold",
                  currentPath === href.replace(/\/$/, "") ? "text-gold" : "text-mist/80",
                ]}
              >
                {t(link.key)}
              </a>
            </li>
          );
        })
      }
      <li class="mt-2 border-t border-white/5 pt-4">
        <a
          href={localizePath(lang, "/login")}
          class="block py-3 text-xs uppercase tracking-luxe text-mist/80 transition-colors hover:text-gold"
        >
          {t("nav.account")}
        </a>
      </li>
    </ul>
  </div>
</div>

<script>
  function bindSideMenu() {
    const toggle = document.getElementById("kvmi-side-menu-toggle");
    const closeBtn = document.getElementById("kvmi-side-menu-close");
    const menu = document.getElementById("kvmi-side-menu");
    const backdrop = document.getElementById("kvmi-side-menu-backdrop");
    const panel = document.getElementById("kvmi-side-menu-panel");
    if (!toggle || !menu || !backdrop || !panel || toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";

    const openMenu = () => {
      menu.classList.remove("pointer-events-none", "opacity-0");
      panel.classList.remove("-translate-x-full");
      panel.classList.add("translate-x-0");
      toggle.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-hidden", "false");
    };

    const closeMenu = () => {
      menu.classList.add("pointer-events-none", "opacity-0");
      panel.classList.add("-translate-x-full");
      panel.classList.remove("translate-x-0");
      toggle.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      if (isOpen) closeMenu();
      else openMenu();
    });

    closeBtn?.addEventListener("click", closeMenu);
    backdrop.addEventListener("click", closeMenu);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") closeMenu();
    });

    /* Cierra el panel de inmediato al elegir un destino, para que la
       siguiente pagina se muestre sin el menu superpuesto. */
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }
  bindSideMenu();
  document.addEventListener("astro:page-load", bindSideMenu);
</script>
