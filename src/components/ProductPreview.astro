---
/*
  Preview de producto con paneo automatico tipo carrusel.
  Cuando el producto tiene mas de una foto, las apila en el mismo recuadro
  y un script (ver Layout.astro) las va alternando con un crossfade suave;
  cada foto visible aplica ademas el paneo lento (Ken Burns) definido en
  global.css. Con una sola foto se comporta como una imagen estatica normal.
*/
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  alt: string;
  aspectClass?: string;
  widths?: number[];
}

const { images, alt, aspectClass = "aspect-[4/5]", widths = [400, 800] } = Astro.props;
const hasMultiple = images.length > 1;
---

<div
  class:list={["relative w-full overflow-hidden", aspectClass]}
  data-kvmi-preview={hasMultiple ? "true" : undefined}
>
  {
    images.map((img, i) => (
      <Image
        src={img}
        alt={i === 0 ? alt : ""}
        widths={widths}
        loading={i === 0 ? "eager" : "lazy"}
        class:list={[
          "absolute inset-0 h-full w-full object-cover transition-opacity duration-[1400ms] ease-in-out",
          hasMultiple
            ? i % 2 === 0
              ? "kvmi-pan-a"
              : "kvmi-pan-b"
            : "transition-transform duration-700 group-hover:scale-105",
          i === 0 ? "opacity-100" : "opacity-0",
        ]}
      />
    ))
  }
</div>
