---
import ProductPreview from "../ProductPreview.astro";
import { collections, products, formatPrice } from "../../lib/catalog";
import { localizePath, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = (path: string) => localizePath(lang, path);

const productsByCollection = collections.map((collection) => ({
  ...collection,
  items: products.filter((prod) => prod.collectionSlug === collection.slug),
}));

const copy = {
  en: {
    kicker: "Exclusive Gifts",
    title: "Collections",
    intro:
      "A premium gallery of limited and personalized editions. Every piece is tasted, approved and numbered before entering the gallery.",
    pieces: (n: number) => `${n} piece(s) in gallery`,
    soon: "Coming soon to the gallery",
    discover: "Discover the piece",
  },
  es: {
    kicker: "Exclusive Gifts",
    title: "Collections",
    intro:
      "Una galeria premium de ediciones limitadas y personalizadas. Cada pieza es catada, aprobada y numerada antes de entrar a la galeria.",
    pieces: (n: number) => `${n} pieza(s) en galeria`,
    soon: "Proximamente en galeria",
    discover: "Descubrir la pieza",
  },
};

const t = copy[lang];
---

<section class="mx-auto max-w-7xl px-6 pt-24 lg:px-10">
  <p class="reveal text-[0.65rem] uppercase tracking-luxe text-gold-deep">{t.kicker}</p>
  <h1 class="reveal reveal-delay-1 mt-6 max-w-3xl font-display text-5xl font-medium leading-tight md:text-7xl">
    <span class="text-gold-gradient">{t.title}</span>
  </h1>
  <p class="reveal reveal-delay-2 mt-8 max-w-xl text-sm leading-relaxed text-mist/70">
    {t.intro}
  </p>

  <nav class="reveal reveal-delay-3 mt-12 flex flex-wrap gap-3">
    {
      collections.map((c) => (
        <a
          href={`#${c.slug}`}
          class="border border-white/10 px-5 py-2.5 text-[0.6rem] uppercase tracking-wide-luxe text-stone transition-colors hover:border-gold-deep hover:text-gold"
        >
          {c.name}
        </a>
      ))
    }
  </nav>
</section>

<section class="mx-auto max-w-7xl px-6 pb-32 pt-24 lg:px-10">
  <div class="space-y-28">
    {
      productsByCollection.map((collection) => (
        <div id={collection.slug} class="scroll-mt-32">
          <div class="reveal flex flex-col gap-4 border-b border-white/5 pb-8 md:flex-row md:items-end md:justify-between">
            <div>
              <h2 class="font-display text-3xl font-medium text-mist md:text-4xl">
                {collection.name}
              </h2>
              <p class="mt-3 max-w-lg text-sm text-mist/60">{collection.description[lang]}</p>
            </div>
            <p class="text-[0.6rem] uppercase tracking-wide-luxe text-stone">
              {collection.items.length > 0 ? t.pieces(collection.items.length) : t.soon}
            </p>
          </div>

          {collection.items.length > 0 && (
            <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {collection.items.map((product) => (
                <a href={p(`/products/${product.slug}`)} class="reveal group block">
                  <div class="relative overflow-hidden bg-cacao/30">
                    <ProductPreview images={product.images} alt={product.name} />
                    <div class="absolute inset-0 bg-gradient-to-t from-night/80 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
                    <span class="absolute bottom-6 left-6 translate-y-4 text-[0.6rem] uppercase tracking-luxe text-gold opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                      {t.discover}
                    </span>
                    {product.serialized && (
                      <span class="absolute right-4 top-4 border border-gold-deep/60 bg-night/70 px-3 py-1 text-[0.55rem] uppercase tracking-wide-luxe text-gold">
                        {lang === "en" ? "Serialized" : "Serializada"}
                      </span>
                    )}
                  </div>
                  <h3 class="mt-6 font-display text-2xl text-mist transition-colors group-hover:text-gold">
                    {product.name}
                  </h3>
                  <p class="mt-1 text-sm italic text-stone">{product.tagline[lang]}</p>
                  <p class="mt-2 text-sm text-mist/80">{formatPrice(product, lang)}</p>
                </a>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>
