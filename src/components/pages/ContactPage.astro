---
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  en: {
    kicker: "The maison listens",
    title: "Contact",
    intro:
      "Special orders, corporate protocol, custom editions or hotel delivery coordination: write to us and a member of the maison will respond personally.",
    atelier: "Atelier",
    email: "Email",
    hours: "Concierge hours",
    hoursValue: "Monday to Sunday, 09h00 - 21h00 (GMT-5)",
    name: "Full name",
    namePlaceholder: "Your name",
    emailLabel: "Email address",
    subject: "Subject",
    subjects: [
      "Special order",
      "Corporate protocol",
      "Hotel delivery",
      "Exclusive handicrafts",
      "Distributors",
      "Other",
    ],
    message: "Message",
    messagePlaceholder: "Tell us about the occasion...",
    send: "Send message",
    success: "Message received. The maison will respond within 24 hours.",
    whatsapp: "WhatsApp",
    whatsappText: "Direct line with the concierge team.",
    whatsappCta: "Open WhatsApp",
    agent: "Virtual agent",
    agentText:
      "The KVMI AI Concierge guides you to the exact piece. Find it at the lower right corner of the gallery.",
    distributors: "Distributors",
    distributorsText:
      "Interested in representing KVMI? Select Distributors in the form and tell us about your market.",
  },
  es: {
    kicker: "La maison le escucha",
    title: "Contact",
    intro:
      "Pedidos especiales, protocolo corporativo, ediciones a medida o coordinacion de entregas en hotel: escribanos y un miembro de la maison respondera personalmente.",
    atelier: "Atelier",
    email: "Correo",
    hours: "Horario del concierge",
    hoursValue: "Lunes a domingo, 09h00 - 21h00 (GMT-5)",
    name: "Nombre completo",
    namePlaceholder: "Su nombre",
    emailLabel: "Correo electronico",
    subject: "Motivo",
    subjects: [
      "Pedido especial",
      "Protocolo corporativo",
      "Entrega en hotel",
      "Artesanias exclusivas",
      "Distribuidores",
      "Otro",
    ],
    message: "Mensaje",
    messagePlaceholder: "Cuentenos la ocasion...",
    send: "Enviar mensaje",
    success: "Mensaje recibido. La maison respondera en menos de 24 horas.",
    whatsapp: "WhatsApp",
    whatsappText: "Linea directa con el equipo concierge.",
    whatsappCta: "Abrir WhatsApp",
    agent: "Agente virtual",
    agentText:
      "El KVMI AI Concierge le guia hacia la pieza exacta. Lo encuentra en la esquina inferior derecha de la galeria.",
    distributors: "Distribuidores",
    distributorsText:
      "Interesado en representar a KVMI? Seleccione Distribuidores en el formulario y cuentenos sobre su mercado.",
  },
};

const t = copy[lang];
---

<section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
  <div class="grid gap-16 lg:grid-cols-2">
    <div>
      <p class="reveal text-[0.65rem] uppercase tracking-luxe text-gold-deep">{t.kicker}</p>
      <h1 class="reveal reveal-delay-1 mt-6 font-display text-5xl font-medium leading-tight md:text-6xl">
        <span class="text-gold-gradient">{t.title}</span>
      </h1>
      <p class="reveal reveal-delay-2 mt-8 max-w-md text-sm leading-relaxed text-mist/70">
        {t.intro}
      </p>

      <dl class="reveal reveal-delay-3 mt-12 space-y-6 text-sm">
        <div>
          <dt class="text-[0.6rem] uppercase tracking-wide-luxe text-gold-deep">{t.atelier}</dt>
          <dd class="mt-1 text-mist/80">Quito, Ecuador</dd>
        </div>
        <div>
          <dt class="text-[0.6rem] uppercase tracking-wide-luxe text-gold-deep">{t.email}</dt>
          <dd class="mt-1 text-mist/80">concierge@kvmi.ec</dd>
        </div>
        <div>
          <dt class="text-[0.6rem] uppercase tracking-wide-luxe text-gold-deep">{t.hours}</dt>
          <dd class="mt-1 text-mist/80">{t.hoursValue}</dd>
        </div>
      </dl>

      <!-- Canales: WhatsApp, agente virtual, distribuidores -->
      <div class="reveal reveal-delay-3 mt-12 space-y-4">
        <div class="border border-white/10 bg-cacao/20 p-6">
          <p class="text-[0.6rem] uppercase tracking-wide-luxe text-gold-deep">{t.whatsapp}</p>
          <p class="mt-2 text-sm text-mist/70">{t.whatsappText}</p>
          <a
            href="https://wa.me/593000000000"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 rounded-full border border-stone/40 px-6 py-2.5 text-[0.6rem] uppercase tracking-wide-luxe text-mist transition-colors hover:border-gold-deep hover:text-gold"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3Z"></path>
              <path d="M9 8.5c0 4 2.5 6.5 6.5 6.5l.8-1.8-2-.9-.9.7c-1.1-.5-1.9-1.3-2.4-2.4l.7-.9-.9-2Z"></path>
            </svg>
            {t.whatsappCta}
          </a>
        </div>
        <div class="border border-white/10 bg-cacao/20 p-6">
          <p class="text-[0.6rem] uppercase tracking-wide-luxe text-gold-deep">{t.agent}</p>
          <p class="mt-2 text-sm text-mist/70">{t.agentText}</p>
        </div>
        <div class="border border-white/10 bg-cacao/20 p-6">
          <p class="text-[0.6rem] uppercase tracking-wide-luxe text-gold-deep">{t.distributors}</p>
          <p class="mt-2 text-sm text-mist/70">{t.distributorsText}</p>
        </div>
      </div>
    </div>

    <form
      id="kvmi-contact-form"
      class="reveal reveal-delay-2 h-fit space-y-6 border border-white/10 bg-cacao/20 p-8 md:p-10"
    >
      <div>
        <label for="contact-name" class="text-[0.6rem] uppercase tracking-wide-luxe text-stone">
          {t.name}
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          class="mt-2 w-full border border-white/10 bg-transparent px-4 py-3 text-sm text-mist placeholder:text-stone/50 focus:border-gold-deep focus:outline-none"
          placeholder={t.namePlaceholder}
        />
      </div>
      <div>
        <label for="contact-email" class="text-[0.6rem] uppercase tracking-wide-luxe text-stone">
          {t.emailLabel}
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          class="mt-2 w-full border border-white/10 bg-transparent px-4 py-3 text-sm text-mist placeholder:text-stone/50 focus:border-gold-deep focus:outline-none"
          placeholder="name@email.com"
        />
      </div>
      <div>
        <label for="contact-subject" class="text-[0.6rem] uppercase tracking-wide-luxe text-stone">
          {t.subject}
        </label>
        <select
          id="contact-subject"
          name="subject"
          class="mt-2 w-full border border-white/10 bg-night px-4 py-3 text-sm text-mist focus:border-gold-deep focus:outline-none"
        >
          {t.subjects.map((subject) => <option>{subject}</option>)}
        </select>
      </div>
      <div>
        <label for="contact-message" class="text-[0.6rem] uppercase tracking-wide-luxe text-stone">
          {t.message}
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          class="mt-2 w-full resize-none border border-white/10 bg-transparent px-4 py-3 text-sm text-mist placeholder:text-stone/50 focus:border-gold-deep focus:outline-none"
          placeholder={t.messagePlaceholder}></textarea>
      </div>
      <button
        type="submit"
        class="rounded-full bg-gold-gradient w-full px-8 py-4 text-[0.65rem] font-semibold uppercase tracking-luxe text-night transition-opacity hover:opacity-90"
      >
        {t.send}
      </button>
      <p id="kvmi-contact-success" class="hidden text-center text-sm text-gold">
        {t.success}
      </p>
    </form>
  </div>
</section>

<script>
  function bindContactForm() {
    const form = document.getElementById("kvmi-contact-form") as HTMLFormElement | null;
    const success = document.getElementById("kvmi-contact-success");
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      /* MVP: en produccion se envia a POST /api/contact/ del backend Django */
      form.reset();
      success?.classList.remove("hidden");
    });
  }
  bindContactForm();
  document.addEventListener("astro:page-load", bindContactForm);
</script>
