---
import { Image } from "astro:assets";
import ARPortal from "../ARPortal.astro";
import { localizePath, type Lang } from "../../i18n/ui";
import ritualImg from "../../assets/images/Demostrations/_fotos_claras_3.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = (path: string) => localizePath(lang, path);

const copy = {
  en: {
    kicker: "The ceremony",
    title: "El Ritual KVMI",
    subtitle: "A sensorial path toward the origin of cacao.",
    cta: "Iniciar Ritual",
    stepsKicker: "Ritual in 5 steps",
    steps: [
      {
        title: "Observe",
        text: "Hold the piece against the light. The shine of the temper and the golden texture anticipate what is coming: cacao worked without haste.",
      },
      {
        title: "Break",
        text: "Listen to the snap. A clean, sonorous break is the signature of a perfect temper and the first act of the ritual.",
      },
      {
        title: "Breathe",
        text: "Bring the piece closer and breathe. The floral notes of Amazonian cacao are released before the first contact with the palate.",
      },
      {
        title: "Melt",
        text: "Do not chew. Let the piece melt slowly and travel the complete profile: jungle, wood, shadow, light.",
      },
      {
        title: "Remember",
        text: "The long finish is the seal of the house. A minute of silence after each piece is the only etiquette we ask for.",
      },
    ],
    videoKicker: "Sensorial video",
    videoTitle: "The ritual, in motion.",
    tastingKicker: "Tasting guide",
    tastingTitle: "Guia de Degustacion",
    tasting: [
      { title: "Aroma", text: "Humid, earthy, deep notes." },
      { title: "Texture", text: "Fine bark, ritual break." },
      { title: "Flavor", text: "Layers of jungle, wood, shadow, light." },
      { title: "Rhythm", text: "Slow, conscious tasting." },
      { title: "Memory", text: "Cacao as an inner journey." },
    ],
    pairingsKicker: "Pairings",
    pairingsTitle: "Maridajes",
    pairings: [
      "Cold Mineral Water",
      "Amazonian Fruits",
      "Dark Rum",
      "Single Origin Coffee",
      "Aromatic Flowers",
    ],
    closing: "The ritual is completed with a piece in hand.",
    closingCta: "Choose my piece",
  },
  es: {
    kicker: "La ceremonia",
    title: "El Ritual KVMI",
    subtitle: "Un camino sensorial hacia el origen del cacao.",
    cta: "Iniciar Ritual",
    stepsKicker: "Ritual en 5 pasos",
    steps: [
      {
        title: "Observar",
        text: "Sostenga la pieza contra la luz. El brillo del temperado y la textura dorada anticipan lo que viene: un cacao trabajado sin prisa.",
      },
      {
        title: "Quebrar",
        text: "Escuche el chasquido. Un corte limpio y sonoro es la firma de un temperado perfecto y el primer acto del ritual.",
      },
      {
        title: "Aromar",
        text: "Acerque la pieza y respire. Las notas florales del cacao amazonico se liberan antes del primer contacto con el paladar.",
      },
      {
        title: "Fundir",
        text: "No mastique. Deje que la pieza se funda lentamente y recorra el perfil completo: selva, madera, sombra, luz.",
      },
      {
        title: "Recordar",
        text: "El final largo es el sello de la casa. Un minuto de silencio despues de cada pieza es la unica etiqueta que pedimos.",
      },
    ],
    videoKicker: "Video sensorial",
    videoTitle: "El ritual, en movimiento.",
    tastingKicker: "Guia de degustacion",
    tastingTitle: "Guia de Degustacion",
    tasting: [
      { title: "Aroma", text: "Notas humedas, terrosas, profundas." },
      { title: "Textura", text: "Corteza fina, quiebre ritual." },
      { title: "Sabor", text: "Capas de selva, madera, sombra, luz." },
      { title: "Ritmo", text: "Degustacion lenta y consciente." },
      { title: "Memoria", text: "El cacao como viaje interior." },
    ],
    pairingsKicker: "Maridajes",
    pairingsTitle: "Maridajes",
    pairings: [
      "Agua Mineral Fria",
      "Frutas Amazonicas",
      "Ron Oscuro",
      "Cafe de Origen",
      "Flores Aromaticas",
    ],
    closing: "El ritual se completa con una pieza en la mano.",
    closingCta: "Elegir mi pieza",
  },
};

const t = copy[lang];

/* Iconos SVG minimalistas para los maridajes (placeholders de linea dorada) */
const pairingIcons = [
  "M12 3v3M8 8h8l-1 11a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2L8 8Z",
  "M12 4c-3 3-5 6-5 9a5 5 0 0 0 10 0c0-3-2-6-5-9Z",
  "M9 4h6M10 4l-1 6a3.5 3.5 0 0 0 2 3.4V19h-2m3-5.6a3.5 3.5 0 0 0 2-3.4l-1-6M9 19h6",
  "M6 9h10v6a4 4 0 0 1-4 4h-2a4 4 0 0 1-4-4V9Zm10 1h2a2 2 0 0 1 0 4h-2",
  "M12 12m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M12 6.5v-2M12 19.5v-2M6.5 12h-2M19.5 12h-2M8.2 8.2 6.8 6.8M17.2 17.2l-1.4-1.4M8.2 15.8l-1.4 1.4M17.2 6.8l-1.4 1.4",
];
---

<!-- HERO -->
<section class="relative flex h-[65vh] items-end overflow-hidden">
  <div class="absolute inset-0" data-parallax="0.08">
    <Image
      src={ritualImg}
      alt="El Ritual KVMI"
      class="h-[115%] w-full object-cover opacity-30"
      widths={[800, 1600]}
      loading="eager"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-night/40 via-transparent to-night"></div>
  <div class="relative mx-auto w-full max-w-7xl px-6 pb-20 lg:px-10">
    <p class="reveal text-[0.65rem] uppercase tracking-luxe text-gold-deep">{t.kicker}</p>
    <h1 class="reveal reveal-delay-1 mt-6 font-display text-5xl font-medium leading-tight md:text-7xl">
      <span class="text-gold-gradient">{t.title}</span>
    </h1>
    <p class="reveal reveal-delay-2 mt-6 max-w-xl font-display text-xl italic text-mist/80">
      {t.subtitle}
    </p>
    <a
      href="#ritual-steps"
      class="reveal reveal-delay-3 rounded-full bg-gold-gradient mt-10 inline-block px-10 py-4 text-[0.65rem] font-semibold uppercase tracking-luxe text-night transition-opacity hover:opacity-90"
    >
      {t.cta}
    </a>
  </div>
</section>

<!-- 5 PASOS -->
<section id="ritual-steps" class="mx-auto max-w-4xl scroll-mt-28 px-6 py-28">
  <p class="reveal text-center text-[0.65rem] uppercase tracking-luxe text-gold-deep">
    {t.stepsKicker}
  </p>
  <ol class="mt-12">
    {
      t.steps.map((step, i) => (
        <li
          class:list={[
            "reveal grid gap-6 border-t border-white/5 py-14 md:grid-cols-[8rem_1fr]",
            i === t.steps.length - 1 && "border-b",
          ]}
        >
          <span class="font-display text-5xl text-gold-deep/40">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div>
            <h2 class="font-display text-3xl font-medium text-mist">{step.title}</h2>
            <p class="mt-4 max-w-xl text-sm leading-relaxed text-mist/70">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<!-- VIDEO SENSORIAL -->
<section class="mx-auto max-w-5xl px-6 pb-28">
  <p class="reveal text-center text-[0.65rem] uppercase tracking-luxe text-gold-deep">
    {t.videoKicker}
  </p>
  <h2 class="reveal reveal-delay-1 mt-4 text-center font-display text-3xl font-medium text-mist">
    {t.videoTitle}
  </h2>
  <div class="reveal reveal-delay-2 relative mt-10 overflow-hidden border border-gold-deep/30">
    <video
      class="aspect-video w-full object-cover"
      src="/videos/Presentation_KVMI_BG.mp4"
      autoplay
      muted
      loop
      playsinline
    ></video>
  </div>
</section>

<!-- GUIA DE DEGUSTACION -->
<section class="border-t border-white/5 bg-cacao/20 py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <p class="reveal text-[0.65rem] uppercase tracking-luxe text-gold-deep">{t.tastingKicker}</p>
    <h2 class="reveal reveal-delay-1 mt-4 font-display text-4xl font-medium text-mist md:text-5xl">
      {t.tastingTitle}
    </h2>
    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
      {
        t.tasting.map((item, i) => (
          <div
            class:list={[
              "reveal border-t border-gold-deep/30 pt-6",
              i % 5 === 1 && "reveal-delay-1",
              i % 5 === 2 && "reveal-delay-2",
              i % 5 === 3 && "reveal-delay-3",
            ]}
          >
            <h3 class="font-display text-2xl text-gold-gradient">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist/70">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- MARIDAJES -->
<section class="mx-auto max-w-7xl px-6 py-28 lg:px-10">
  <p class="reveal text-center text-[0.65rem] uppercase tracking-luxe text-gold-deep">
    {t.pairingsKicker}
  </p>
  <h2 class="reveal reveal-delay-1 mt-4 text-center font-display text-4xl font-medium italic text-gold-gradient md:text-5xl">
    {t.pairingsTitle}
  </h2>
  <div class="mt-16 grid grid-cols-2 gap-8 md:grid-cols-5">
    {
      t.pairings.map((pairing, i) => (
        <div class="reveal flex flex-col items-center gap-4 text-center">
          <span class="flex h-16 w-16 items-center justify-center border border-gold-deep/40">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="#CE8B00"
              stroke-width="1.1"
              class="h-8 w-8"
              aria-hidden="true"
            >
              <path d={pairingIcons[i]} />
            </svg>
          </span>
          <p class="text-[0.65rem] uppercase tracking-wide-luxe text-mist/80">{pairing}</p>
        </div>
      ))
    }
  </div>
</section>

<!-- AR EXPERIENCE -->
<section class="mx-auto max-w-5xl px-6 pb-28">
  <div class="reveal">
    <ARPortal lang={lang} />
  </div>
</section>

<!-- CIERRE -->
<section class="border-t border-white/5 py-24 text-center">
  <p class="reveal text-sm italic text-stone">{t.closing}</p>
  <a
    href={p("/collections")}
    class="reveal reveal-delay-1 rounded-full bg-gold-gradient mt-8 inline-block px-10 py-4 text-[0.65rem] font-semibold uppercase tracking-luxe text-night transition-opacity hover:opacity-90"
  >
    {t.closingCta}
  </a>
</section>
