DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Salida de emergencia SOLO para desarrollo local sin SQL Server configurado.
# Debe permanecer en False salvo en tu maquina; nunca se activa en CI/prod.
USE_SQLITE_FOR_DEV=False

MSSQL_DB_NAME=kvmi
MSSQL_DB_USER=kvmi_app
MSSQL_DB_PASSWORD=
MSSQL_DB_HOST=localhost
MSSQL_DB_PORT=1433
MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

FRONTEND_ORIGIN=http://localhost:4321

GEMINI_API_KEY=
